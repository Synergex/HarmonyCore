<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <PackAsTool>true</PackAsTool>
    <AssemblyName>Harmony.Core.CliTool</AssemblyName>
    <ToolCommandName>harmonycore</ToolCommandName>
    <PackageId>Harmony.Core.CliTool</PackageId>
    <PackageVersion>6.0.148</PackageVersion>
    <Version>6.0.148</Version>
    <!-- .NET global tools are framework-dependent and RID-agnostic. Clear the repo-wide
         RuntimeIdentifiers (win-x64;win-x86;linux-x64 from Directory.Build.Props): otherwise
         `dotnet pack` fans out a per-RID build of the CodeGen ProjectReferences, and each RID
         rebuilds the SAME CodeGenEngine.dll into the SAME (non-RID-keyed) %LOCALAPPDATA%\Synergex\dbp
         cache dir, so the builds collide (DBL-E-ASMLOAD "Could not find a part of the path").
         AnyCPU avoids NETSDK1032. The x64 'publish' task passes -r explicitly, so it is unaffected. -->
    <RuntimeIdentifiers></RuntimeIdentifiers>
    <PlatformTarget>AnyCPU</PlatformTarget>
  </PropertyGroup>

	<PropertyGroup Condition="'$(BUILD_BUILDNUMBER) ' != ' '">
		<PackageVersion>$(BUILD_BUILDNUMBER)</PackageVersion>
		<Version>$(BUILD_BUILDNUMBER)</Version>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
	  <WarningsAsErrors />
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
	  <WarningsAsErrors />
	</PropertyGroup>
	
  <ItemGroup>
    <PackageReference Include="CommandLineParser" Version="2.9.1" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="Microsoft.Build.Tasks.Core" Version="17.14.28" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Scripting" Version="4.11.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="Octokit" Version="13.0.1" />
    <PackageReference Include="Synergex.SynergyDE.synrnt" Version="12.4.1.1005" />
    <PackageReference Include="System.CodeDom" Version="9.0.0" />
    <PackageReference Include="System.Runtime" Version="4.3.1" />
    <PackageReference Include="Terminal.Gui" Version="1.17.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\CodeGen\DotNetCore\CodeGenEngine\CodeGenEngine.synproj" />
    <ProjectReference Include="..\CodeGen\DotNetCore\HarmonyCoreCodeGen.Core\HarmonyCoreCodeGen.Core.synproj" />
    <ProjectReference Include="..\CodeGen\DotNetCore\HarmonyCoreExtensions\HarmonyCoreExtensions.synproj" />
    <ProjectReference Include="..\CodeGen\DotNetCore\MethodCatalogAPI\MethodCatalogAPI.synproj" />
    <ProjectReference Include="..\CodeGen\DotNetCore\RepositoryAPI\RepositoryAPI.synproj" />
  </ItemGroup>
</Project>
